# Required in production: generate a long random secret and keep it private.
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
PORT=3000

# User account file directory. Local default is the project folder.
# Hosted ephemeral storage can lose registrations after a restart/redeploy.
DATA_DIR=./data

# Optional: n8n webhook URLs stay on the server, never in browser code.
N8N_RESET_WEBHOOK=
N8N_ALERT_WEBHOOK=
ALERT_COOLDOWN_MIN=10

# Optional: configure email delivery for HIGH-risk alerts.
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Set to your deployed public URL for password-reset links.
PUBLIC_URL=

# Cookie policy. Keep Lax for same-origin deployment.
COOKIE_SAMESITE=Lax
